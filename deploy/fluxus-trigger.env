# Deploy to: /etc/fluxus-trigger.env
# Asterisk Manager Interface credentials
# Must match the section name in /etc/asterisk/manager.conf
AMI_USER=fluxus
AMI_SECRET=kx9Qm4vTpL2w

# AMI connection (defaults are fine for local Asterisk)
AMI_HOST=127.0.0.1
AMI_PORT=5038

# Directory containing instruction WAV files (the audio USB stick mount point)
AUDIO_DIR=/mnt/audio

# Random delay range between calls, in seconds
MIN_WAIT=300
MAX_WAIT=1800
