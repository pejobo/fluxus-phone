# Deploy to: /etc/systemd/system/fluxus-trigger.service
[Unit]
Description=Fluxus phone trigger
After=asterisk.service
Wants=asterisk.service

[Service]
EnvironmentFile=/etc/fluxus-trigger.env
ExecStart=/usr/bin/python3 -u /usr/local/bin/fluxus-trigger.py
Restart=always
RestartSec=10
StartLimitIntervalSec=0
User=asterisk

[Install]
WantedBy=multi-user.target
